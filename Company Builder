        txt += `Ready for mission: ${missionReadyRoster.value.length} / ${company.roster.length}\n`;
      } else txt += `Not rolled yet.\n`;
      txt += `\n--- ENEMY FORCE (${company.faction} / ${company.difficulty}) ---\n`;
      txt += `Target: ${enemyTargetPts.value} pts — Generated: ${enemyTotalPts.value} pts — Units: ${company.enemy.length}\n`;
      company.enemy.forEach((e,i) => {
        txt += `${i+1}. ${e.name} — ${e.pts} pts\n`;
        if (e.stats) txt += `   Stats: M${e.stats.M} WS${e.stats.WS} BS${e.stats.BS} S${e.stats.S} T${e.stats.T} W${e.stats.W} I${e.stats.I} A${e.stats.A} Ld${e.stats.Ld}\n`;
        txt += `   Wargear: ${e.wargear || '—'}\n   Rules: ${e.rules || '—'}\n`;
      });
      txt += `\n--- BOSS FIGHT ---\n`;
      txt += `${bossUnit.value.name} — ${bossUnit.value.pts} pts\n`;
      if (bossUnit.value.stats) { const s = bossUnit.value.stats; txt += `  Stats: M${s.M} WS${s.WS} BS${s.BS} S${s.S} T${s.T} W${s.W} I${s.I} A${s.A} Ld${s.Ld}\n`; }
      txt += `  Wargear: ${bossUnit.value.wargear}\n  Rules: ${bossUnit.value.rules}\n`;
      txt += `\n--- MISSIONS ---\n`;
      company.missions.forEach((m,i) => {
        txt += `Mission ${i+1}: ${m.scenario}\n`;
        if (m.weatherOn) txt += `  Weather: ${m.weather}\n`;
        if (m.randomEventsOn) txt += `  Random Events: ON\n`;
        if (m.bossOn) txt += `  BOSS: ${bossUnit.value.name} (${bossUnit.value.pts} pts)\n`;
      });
      txt += `\n--- OBJECTIVES ---\n`;
      if (currentPrimary.value.roll) txt += `Primary: [${currentPrimary.value.roll}] ${currentPrimary.value.name}\n  ${currentPrimary.value.desc}\n`;
      if (currentSecondary.value.roll) txt += `Secondary: [${currentSecondary.value.roll}] ${currentSecondary.value.name}\n  ${currentSecondary.value.desc}\n`;
      txt += `Alertness: ${alertness.value} | Primary completed: ${primaryCompleted.value} | Secondary completed: ${secondaryCompleted.value}\n`;
      if (rewardsClaimed.value) txt += `Rewards: ${hazardPay.value}c + ${totalCampaignXP.value} XP\n`;
      txt += `\n--- SEARCH TOKENS ---\n`;
      searchState.tokens.forEach((t,i) => {
        txt += `Token #${i+1}: ${t.group} ${t.num || '(player picks)'}`;
        if (t.content) txt += ` → ${t.content.label}: ${t.content.detail}`;
        txt += `\n`;
      });
      txt += `\n--- ENEMY WAVES ---\n`;
      txt += `Wave target: ${waveTargetPts()} pts | Current wave: ${waveState.currentWave}\n`;
      txt += `Alertness: ${waveState.alertness}/6 | Awareness: ${waveState.awareness}\n`;
      waveState.sentries.forEach(s => txt += `Sentry: ${s.unit.name} (${s.quarter ? 'Q'+s.quarter : 'player picks'})\n`);
      waveState.reinforcements.forEach(r => txt += `Reinf: ${r.unit.name} (${r.corner ? 'C'+r.corner : 'player picks'})\n`);
      txt += `\n--- RANDOM EVENTS ---\n`;
      eventLog.value.forEach(e => txt += `[${e.d1}][${e.d2}] ${e.name} — ${e.desc}\n`);
      const b = new Blob([txt], { type:'text/plain;charset=utf-8' });
      const a = document.createElement('a'); a.href = URL.createObjectURL(b);
      a.download = `Campaign_${company.squadName || 'Hero'}.txt`; a.click();
    }

    function exportCampaignPDF() {
      if (!window.jspdf) return alert("jsPDF not loaded.");
      const { jsPDF } = window.jspdf;
      const doc = new jsPDF();
      doc.setFontSize(16); doc.text('ASTARTES CAMPAIGN', 20, 20);
      doc.setFontSize(10);
      doc.text(`Squad: ${company.squadName || 'Unnamed'}`, 20, 30);
      doc.text(`Points: ${squadTotalPts.value} pts | Enemy: ${company.faction} / ${company.difficulty}`, 20, 36);
      let y = 46;
      doc.setFontSize(12); doc.text('ROSTER', 20, y); y += 6;
      doc.setFontSize(9);
      company.roster.forEach(c => { doc.text(`- ${c.name || 'Unnamed'} (${c.chapter}) — ${calcCharCost(c)} pts`, 20, y); y += 5; });
      y += 4;
      doc.setFontSize(12); doc.text('ENEMY FORCE', 20, y); y += 6;
      doc.setFontSize(9);
      company.enemy.forEach(e => {
        doc.text(`- ${e.name} — ${e.pts} pts`, 20, y); y += 4;
        if (e.stats) { doc.text(`  M${e.stats.M} WS${e.stats.WS} BS${e.stats.BS} S${e.stats.S} T${e.stats.T} W${e.stats.W} I${e.stats.I} A${e.stats.A} Ld${e.stats.Ld}`, 22, y); y += 4; }
      });
      y += 4;
      doc.setFontSize(12); doc.text('BOSS FIGHT', 20, y); y += 6;
      doc.setFontSize(9);
      doc.text(`${bossUnit.value.name} — ${bossUnit.value.pts} pts`, 20, y); y += 5;
      if (bossUnit.value.stats) { const s = bossUnit.value.stats; doc.text(`M${s.M} WS${s.WS} BS${s.BS} S${s.S} T${s.T} W${s.W} I${s.I} A${s.A} Ld${s.Ld}`, 20, y); y += 5; }
      doc.text(`Wargear: ${bossUnit.value.wargear}`, 20, y); y += 5;
      doc.text(`Rules: ${bossUnit.value.rules}`, 20, y);
      doc.save(`Campaign_${company.squadName || 'Hero'}.pdf`);
    }

    onMounted(() => { loadLocal(); });

    return {
      // Builder
      char, chapters, classes, wargearCats, currentRank, innateRules,
      showLibrary, library, wargearWarning,
      availableExp, spentExp, totalCost, selectedProfiles,
      usedHands, maxHands, meleeAttacks, isBlocked, tryAdd, removeItem,
      increaseStat, decreaseStat, toggleSkill, applyPreset, resetChar,
      toggleTheme, saveNewCharacter, loadCharacter, deleteCharacter,
      exportTXT, exportPDF, getSkillDesc, skillList, availableSkills: skillList, baseStats,
      // Company
      tab, company, factions, difficulties, missionScenarios, weatherTable,
      squadTotalPts, enemyTargetPts, enemyTotalPts, enemyBreakdown, bossUnit,
      calcCharCost, addToRoster, generateEnemy,
      exportCampaignTXT, exportCampaignPDF,
      // Objectives
      currentPrimary, currentSecondary, primaryCompleted, secondaryCompleted,
      alertness, chosenCorner, rewardsClaimed,
      rollPrimaryObjective, completePrimary, completeSecondary, resetObjectives,
      diffLevel, hazardPay, primaryXP, secondaryXP, totalCampaignXP, claimRewards,
      // Injuries / Pre-Game
      rollInjury,
      preGameState, runPreGameChecks, clearPreGame, missionReadyRoster,
      // Import TXT
      rosterFileInput, importRosterTXT, onRosterFileSelected,
      // Search Tokens
      searchState, rollSearchTokens, revealSearchToken,
      // Waves
      waveState, waveTargetPts, deploySentries, deployReinforcements, tickAlertness, awarenessTable,
      // Challenges
      challengeState, todTable, weatherChallengeTable,
      // Hero Deployment
      heroDeployment, rollHeroDeployment,
      // Random Events
      randomEvents, eventLog, lastEvent, rollRandomEvent
    };
  }
});

app.mount("#app");
</script>
</body>
</html>
