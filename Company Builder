    function applyInjuryEffect(hero, inj) {
      if (!hero.injuries) hero.injuries = [];
      if (inj.type === 'perm' || inj.type === 'hand') hero.injuries.push(inj.name);
      if (inj.type === 'head') hero.injuries.push('Head Wound (Stupidity/Frenzy)');
      if (inj.type === 'old') hero.injuries.push('Old Battle Wound (miss on D6=1)');
      if (inj.type === 'enmity') hero.injuries.push('Bitter Enmity');
      if (inj.type === 'captured') { hero.injuries.push('CAPTURED'); hero.captured = true; }
      if (inj.type === 'scars') hero.injuries.push('Causes Fear (scars)');
      if (inj.type === 'special') hero.injuries.push('Partially Deafened');
    }

    function rollInjury(idx) {
      const hero = company.roster[idx];
      if (!hero) return;
      if (!hero.injuries) hero.injuries = [];
      if (!hero.injuryLog) hero.injuryLog = [];
      let result = rollSeriousInjury();
      let log = [`[${result.d1}][${result.d2}] ${result.name}`];
      if (result.type === 'multiple') {
        const extra = Math.floor(Math.random()*3)+1 + 1;
        for (let k=0; k<extra; k++) {
          let rr;
          do { rr = rollSeriousInjury(); } while (['dead','multiple','captured','recover'].includes(rr.type));
          log.push(`  → [${rr.d1}][${rr.d2}] ${rr.name}`);
          applyInjuryEffect(hero, rr);
        }
      } else {
        applyInjuryEffect(hero, result);
      }
      hero.injuryLog.push(log.join('\n'));
      if (result.type === 'dead') {
        alert(`${hero.name || 'Hero'} is DEAD — removed from roster.`);
        company.roster.splice(idx, 1);
        return;
