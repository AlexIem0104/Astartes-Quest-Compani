        if (q > 0) {
          let per = it.hands || 0;
          if (it.name === 'Thunder Hammer' && isTerminator.value) per = 1;
          if (isTerminator.value && it.cat === 'heavy') per = 1;
          h += q * per;
        }
      }
      return h;
