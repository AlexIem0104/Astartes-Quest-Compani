      if (item.name === "Assault Launcher" && !isGravis.value) return true;
      if (item.name === "Volkite Charger" && char.cls !== "Terminator" && !isTerminator.value) return true;
      if (item.name === "Heavy Bolt Rifle" && (char.cls !== "Heavy Support" && !isGravis.value)) return true;
      if (item.name.startsWith("Deathwatch") && char.chapter !== "Deathwatch") return true;
      if (item.name.startsWith("Gravis") && !isGravis.value) return true;
      let per = item.hands || 0;
      if (item.name === 'Thunder Hammer' && isTerminator.value) per = 1;
      if (isTerminator.value && item.cat === 'heavy') per = 1;
      if ((usedHands.value + per) > maxHands.value) return true;
      let catCount = 0;
