    function rollSeriousInjury() {
      const d1 = Math.floor(Math.random()*6)+1;
      const d2 = Math.floor(Math.random()*6)+1;
      const key = d1*10 + d2;
      const inj = seriousInjuries[key] || { name:'—', type:'recover', desc:'No effect.' };
      return { key, d1, d2, ...inj };
