<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Astartes Builder — WH40K Campaign</title>
<script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<style>
  :root{--bg-base:#0a0202;--panel:#150505;--panel2:#1f0808;--line:#441111;--line-highlight:#882222;--txt:#eebbdd;--dim:#995555;--gold:#d43838;--red:#ff2222;--green:#4a7c59;--metal-text:linear-gradient(180deg,#ffffff 0%,#bb8888 50%,#551111 100%);--input-bg:#050000;}
  body[data-theme="light"]{--bg-base:#e8e0d5;--panel:#f4f0ea;--panel2:#eaddcd;--line:#c4b5a5;--line-highlight:#a8927e;--txt:#332222;--dim:#665555;--gold:#993333;--red:#cc0000;--green:#2b6b3f;--metal-text:linear-gradient(180deg,#552222 0%,#441111 100%);--input-bg:#ffffff;}
  *{box-sizing:border-box}
  body{margin:0;font-family:"Segoe UI",Roboto,sans-serif;background:var(--bg-base);color:var(--txt);font-size:14px;min-height:100vh;transition:background-color .3s,color .3s}
  header{background:linear-gradient(90deg,var(--panel) 0%,var(--panel2) 50%,var(--panel) 100%);border-bottom:2px solid var(--line-highlight);padding:10px 20px;display:flex;flex-wrap:wrap;gap:20px;align-items:center;box-shadow:0 4px 15px rgba(0,0,0,.5);position:sticky;top:0;z-index:100}
  .aquila-logo{width:100px;height:auto;filter:drop-shadow(0 0 8px rgba(0,0,0,.8)) drop-shadow(0 0 2px rgba(255,255,255,.2));transition:transform .3s ease}
  .aquila-logo:hover{transform:scale(1.05)}
  .aquila-logo path{fill:var(--txt);transition:fill .3s}
  body[data-theme="light"] .aquila-logo path{fill:#332222}
  header h1{margin:0;font-size:24px;letter-spacing:4px;color:#fff;background-clip:text;-webkit-background-clip:text;background-image:var(--metal-text);text-transform:uppercase;font-weight:800;text-shadow:0 2px 4px rgba(0,0,0,.8)}
  .top-controls{margin-left:auto;display:flex;gap:10px;align-items:center;flex-wrap:wrap}
  .btn{background:var(--panel2);color:var(--txt);border:1px solid var(--line);padding:6px 12px;border-radius:2px;cursor:pointer;font-size:13px;transition:.2s;font-weight:600}
  .btn:hover{border-color:var(--gold);color:var(--gold)}
  .btn.active{border-color:var(--gold);color:var(--gold);background:var(--panel2)}
  .btn-danger{border-color:var(--red);color:var(--red)}
  .btn-danger:hover{background:var(--red);color:#fff}
  main{display:grid;grid-template-columns:380px 1fr 420px;gap:15px;padding:15px;max-width:1800px;margin:0 auto;align-items:start}
  @media (max-width:1400px){main{grid-template-columns:1fr 1fr}}
  @media (max-width:900px){main{grid-template-columns:1fr}}
  .panel{background:var(--panel);border:1px solid var(--line);border-top:2px solid var(--line-highlight);border-radius:3px;padding:15px;box-shadow:0 5px 15px rgba(0,0,0,.3)}
  .panel h2{margin:0 0 12px 0;font-size:13px;text-transform:uppercase;letter-spacing:1.5px;color:var(--gold);border-bottom:1px solid var(--line);padding-bottom:6px}
  input[type="text"],input[type="number"],select,textarea{width:100%;background:var(--input-bg);color:var(--txt);border:1px solid var(--line);border-radius:2px;padding:8px 10px;font-family:inherit;font-size:13px;outline:none;transition:border .2s}
  input:focus,select:focus,textarea:focus{border-color:var(--gold)}
  label{font-size:11px;color:var(--dim);text-transform:uppercase;display:block;margin-bottom:4px;margin-top:8px}
  .grid-2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .grid-stats{display:grid;grid-template-columns:repeat(5,1fr);gap:5px;margin-top:10px;text-align:center}
  .stat-box{background:var(--panel2);padding:6px;border:1px solid var(--line);border-radius:2px}
  .stat-box .s-name{font-size:10px;color:var(--dim);font-weight:bold}
  .stat-box .s-val{font-size:16px;font-weight:bold;color:var(--txt)}
  .stat-box .s-controls{display:flex;justify-content:center;gap:5px;margin-top:5px}
  .stat-box .s-controls button{background:var(--panel);border:1px solid var(--line);color:var(--txt);cursor:pointer;padding:2px 6px;border-radius:2px;font-size:12px}
  .stat-box .s-controls button:hover:not(:disabled){border-color:var(--gold);color:var(--gold)}
  .stat-box .s-controls button:disabled{opacity:.3;cursor:not-allowed}
  .item-list{max-height:500px;overflow-y:auto;padding-right:5px}
  .item{display:flex;align-items:center;padding:6px 0;border-bottom:1px solid var(--line);gap:8px;font-size:13px}
  .item.disabled{opacity:.5}
  .item-name{flex:1;cursor:pointer;font-size:13px;color:var(--txt);display:flex;align-items:center;gap:5px;flex-wrap:wrap}
  .item-name:hover{color:#fff}
  .item .cost{font-family:monospace;color:var(--gold);font-size:12px}
  .qty-controls{display:flex;align-items:center;gap:5px}
  .qty-controls button{padding:2px 6px;font-size:12px;cursor:pointer;background:var(--panel);border:1px solid var(--line);color:var(--txt);border-radius:2px}
  .qty-controls button:hover:not(:disabled){border-color:var(--gold);color:var(--gold)}
  .qty-controls button:disabled{opacity:.3;cursor:not-allowed}
  .qty-val{font-weight:bold;width:15px;text-align:center;color:var(--green)}
  .inline-select{font-size:10px;padding:2px;background:var(--input-bg);color:var(--txt);border:1px solid var(--line);border-radius:2px}
  .summary-box{background:var(--panel2);padding:10px;border:1px solid var(--line);margin-top:15px;border-radius:2px}
  .summary-row{display:flex;justify-content:space-between;font-size:13px;padding:3px 0;color:var(--dim)}
  .summary-row.total{border-top:1px solid var(--gold);margin-top:5px;padding-top:8px;font-size:16px;font-weight:bold;color:var(--txt)}
  .alert{padding:10px;background:rgba(255,0,0,.1);border:1px solid var(--red);color:var(--red);margin-bottom:10px;font-size:12px;display:none}
  .alert.show{display:block}
  .preset-btns{display:flex;gap:5px;flex-wrap:wrap;margin-bottom:15px}
  .preset-btns button{flex:1;font-size:11px;padding:5px 2px}
  .weapon-card{background:var(--panel2);border:1px solid var(--line);border-left:2px solid var(--gold);padding:10px;margin-bottom:10px;font-size:12px}
  .weapon-card .wname{font-weight:bold;color:var(--gold);text-transform:uppercase;margin-bottom:5px;letter-spacing:1px;display:flex;justify-content:space-between}
  .weapon-card table{width:100%;border-collapse:collapse;margin-bottom:5px}
  .weapon-card th{font-size:9px;color:var(--dim);text-transform:uppercase;border-bottom:1px solid var(--line);padding:2px;text-align:center}
  .weapon-card td{font-family:monospace;text-align:center;padding:3px;border-bottom:1px solid var(--line);color:var(--txt);font-size:11px}
  .weapon-card .wspecial{font-size:11px;color:var(--dim);font-style:italic}
  .rule-box{margin-bottom:8px;padding-left:8px;border-left:2px solid var(--dim)}
  .rule-title{font-weight:bold;color:var(--txt);font-size:13px;margin-bottom:2px}
  .rule-desc{font-size:12px;color:var(--dim);line-height:1.4}
  .modal{position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.8);display:flex;justify-content:center;align-items:center;z-index:1000}
  .modal-content{background:var(--panel);padding:20px;border:2px solid var(--gold);width:400px;max-width:90%;border-radius:4px}
  .char-list{list-style:none;padding:0;margin:0 0 15px 0;max-height:200px;overflow-y:auto}
  .char-list li{padding:10px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center}

  .company-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px;padding:15px;max-width:1800px;margin:0 auto;align-items:start}
  @media(max-width:1100px){.company-grid{grid-template-columns:1fr}}
  .unit-row{display:flex;justify-content:space-between;align-items:center;padding:6px 0;border-bottom:1px solid var(--line);font-size:13px;gap:8px}
  .roster-badge{background:var(--panel2);border:1px solid var(--gold);padding:2px 8px;border-radius:2px;color:var(--gold);font-size:11px;white-space:nowrap}
  .mission-card{background:var(--panel2);border:1px solid var(--line);border-left:3px solid var(--gold);padding:10px;margin-bottom:10px}
  .mission-card h4{margin:0 0 6px 0;color:var(--gold);font-size:12px;text-transform:uppercase;letter-spacing:1px}
  .mission-card select,.mission-card textarea{margin-top:4px}
  .boss-card{background:linear-gradient(135deg,var(--panel2),var(--panel));border:2px solid var(--red);padding:12px;margin-top:10px}
  .boss-card h4{color:var(--red);margin:0 0 8px 0;text-transform:uppercase;letter-spacing:2px}
  .warn-pts{color:var(--red);font-weight:bold}
  .objective-box{background:var(--panel2);border:1px solid var(--line);border-left:3px solid var(--gold);padding:10px;margin:8px 0;font-size:12px}
  .objective-box .tag{display:inline-block;font-size:10px;padding:1px 6px;border-radius:2px;text-transform:uppercase;letter-spacing:1px;margin-right:6px}
  .tag-primary{background:var(--gold);color:#000}
  .tag-secondary{background:var(--red);color:#fff}
  .tag-alert{background:var(--green);color:#fff}
  .injury-badge{display:inline-block;font-size:10px;padding:1px 6px;border-radius:2px;background:rgba(255,34,34,.15);border:1px solid var(--red);color:var(--red);margin:2px 2px 0 0}
  .corner-pick{display:grid;grid-template-columns:repeat(4,1fr);gap:4px;margin-top:4px}
  .corner-pick button{font-size:11px;padding:4px 2px}
  .corner-pick button.sel{border-color:var(--gold);color:var(--gold);background:var(--panel2)}
  .reward-row{display:flex;justify-content:space-between;font-size:12px;padding:2px 0;color:var(--dim)}
  .reward-row b{color:var(--green)}
  h4.section-h{color:var(--gold);margin-top:10px;font-size:11px;text-transform:uppercase;letter-spacing:1px}
  .hint-box{font-size:11px;color:var(--dim);background:var(--panel2);border:1px dashed var(--line);padding:6px 8px;border-radius:2px;margin-bottom:8px}
  .stat-line{font-family:monospace;font-size:11px;color:var(--dim);margin-top:2px}
  .enemy-card{background:var(--panel2);border:1px solid var(--line);padding:8px;margin-bottom:8px;border-radius:2px}
</style>
</head>
<body data-theme="dark">

<div id="app">
  <header>
    <svg class="aquila-logo" viewBox="0 0 1000 400" xmlns="http://www.w3.org/2000/svg">
      <path d="M430 120 L400 70 L380 120 L340 100 L360 150 L200 40 L280 160 L140 60 L240 180 L100 100 L220 200 L80 150 L200 240 L60 210 L180 280 L40 260 L180 310 L20 300 L160 350 L10 340 L160 390 L0 380 L160 400 L160 360 L200 360 L200 300 L240 320 L240 260 L280 280 L280 200 L320 240 L340 180 L360 200 L360 120 L400 150 L430 120 Z" fill="currentColor"/>
      <path d="M570 120 L600 70 L620 120 L660 100 L640 150 L800 40 L720 160 L860 60 L760 180 L900 100 L780 200 L920 150 L800 240 L940 210 L820 280 L960 260 L820 310 L980 300 L840 350 L990 340 L840 390 L1000 380 L840 400 L840 360 L800 360 L800 300 L760 320 L760 260 L720 280 L720 200 L680 240 L660 180 L640 200 L640 120 L600 150 L570 120 Z" fill="currentColor"/>
      <path d="M490 100 L520 60 L550 100 L530 140 L570 140 L520 200 L550 250 L520 320 L500 380 L480 320 L450 250 L480 200 L430 140 L470 140 L450 100 L490 100 Z" fill="currentColor"/>
      <circle cx="490" cy="110" r="10" fill="var(--bg-base)"/>
      <path d="M450 250 L420 280 L450 320 L480 280 Z" fill="currentColor"/>
      <path d="M550 250 L580 280 L550 320 L520 280 Z" fill="currentColor"/>
    </svg>
    <h1>Astartes Builder</h1>
    <div class="top-controls">
      <button class="btn" :class="{active: tab==='company'}" @click="tab='company'">⚔ Company</button>
      <button class="btn" :class="{active: tab==='builder'}" @click="tab='builder'">🛠 Builder</button>
      <button class="btn" @click="toggleTheme">🌓 Theme</button>
      <button v-if="tab==='builder'" class="btn" @click="saveNewCharacter">💾 Save</button>
      <button v-if="tab==='builder'" class="btn" @click="showLibrary=true">📚 Library</button>
      <button v-if="tab==='builder'" class="btn" @click="exportTXT">⬇ TXT</button>
      <button v-if="tab==='builder'" class="btn" @click="exportPDF">📄 PDF</button>
      <button v-if="tab==='builder'" class="btn btn-danger" @click="resetChar">↺ Reset</button>
    </div>
  </header>

  <!-- ============ BUILDER ============ -->
  <main v-if="tab==='builder'">
    <div class="panel">
      <h2>1. Personal Data</h2>
      <div class="grid-2">
        <div><label>Character Name</label><input type="text" v-model="char.name" placeholder="e.g., Leonatos"></div>
        <div><label>Campaign</label><input type="text" v-model="char.campaign" placeholder="Campaign Name"></div>
      </div>
      <h2 style="margin-top:20px;">2. Chapter & Profession</h2>
      <div class="grid-2">
        <div>
          <label>Chapter</label>
          <select v-model="char.chapter">
            <option v-for="(c, name) in chapters" :value="name">{{ name }} ({{ c.cost }} pts)</option>
          </select>
        </div>
        <div>
          <label>Profession</label>
          <select v-model="char.cls">
            <option v-for="(c, name) in classes" :value="name">{{ name }} ({{ c.cost }} pts)</option>
          </select>
        </div>
      </div>
      <div style="font-size:11px;color:var(--dim);margin-top:5px;">{{ classes[char.cls].desc }}</div>
      <h2 style="margin-top:20px;">3. Experience & Rank</h2>
      <div class="grid-2">
        <div><label>Total Experience (EXP)</label><input type="number" v-model.number="char.exp" min="0"></div>
        <div><label>Rank</label><input type="text" :value="currentRank.rank + ' (Level ' + currentRank.lvl + ')'" readonly></div>
      </div>
      <h2 style="margin-top:20px;">4. Characteristics</h2>
      <div class="grid-stats">
        <div class="stat-box" v-for="(val, stat) in char.stats" :key="stat">
          <div class="s-name">{{ stat }}</div>
          <div class="s-val">{{ val }}</div>
          <div class="s-controls">
            <button @click="decreaseStat(stat)" :disabled="val <= baseStats[stat]">−</button>
            <button @click="increaseStat(stat)" :disabled="val >= currentRank.maxStats[stat] || availableExp < 10">+</button>
          </div>
        </div>
      </div>
      <div class="summary-box" style="margin-top:15px;">
        <div class="summary-row" style="color:var(--gold);font-weight:bold;">
          <span>Innate Rules:</span><span>{{ innateRules }}</span>
        </div>
      </div>
    </div>

    <div class="panel">
      <h2>6. Wargear (Hands Used: {{ usedHands }} / {{ maxHands }})</h2>
      <div class="alert" :class="{show: wargearWarning}">{{ wargearWarning }}</div>
      <div class="preset-btns">
        <button class="btn" @click="applyPreset('assault')">Assault</button>
        <button class="btn" @click="applyPreset('heavy')">Heavy Support</button>
        <button class="btn" @click="applyPreset('commander')">Commander</button>
        <button class="btn" @click="applyPreset('terminator')">Terminator</button>
        <button class="btn" @click="applyPreset('gravis')">Gravis (Dual)</button>
        <button class="btn" @click="applyPreset('techmarine')">Techmarine</button>
      </div>
      <div class="item-list">
        <div v-for="(cat, catKey) in wargearCats" :key="catKey" style="margin-bottom:15px;">
          <div style="font-size:11px;color:var(--gold);margin-bottom:5px;font-weight:bold;text-transform:uppercase;">{{ cat.label }}</div>
          <div class="item" v-for="item in cat.items" :key="item.name">
            <div class="item-name" @click="tryAdd(item)">
              <span>{{ item.name }}</span>
              <span style="font-size:10px;color:var(--dim);" v-if="item.hands > 0">({{ item.hands }}h)</span>
              <select v-if="item.name === 'Combi-Grenade Launcher' && char.wargear[item.name] > 0"
                      v-model="char.combiGrenadeType" class="inline-select" @click.stop>
                <option value="Frag">Frag</option>
                <option value="Krak">Krak</option>
              </select>
            </div>
            <span class="cost">{{ item.cost }} pts</span>
            <div class="qty-controls">
              <button @click.stop="removeItem(item)" :disabled="!char.wargear[item.name]">−</button>
              <span class="qty-val">{{ char.wargear[item.name] || 0 }}</span>
              <button @click.stop="tryAdd(item)" :disabled="isBlocked(item)">+</button>
            </div>
          </div>
        </div>
      </div>
      <h2 style="margin-top:20px;">7. Skills (Necromunda)</h2>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:5px;">
        <div class="item" v-for="skill in availableSkills" :key="skill.name">
          <input type="checkbox" :id="'sk_'+skill.name" :value="skill.name" v-model="char.skills" @change="toggleSkill(skill.name)">
          <label :for="'sk_'+skill.name">{{ skill.name }} <span style="color:var(--dim)">({{ skill.cat }})</span> — 10 EXP / 10 pts</label>
        </div>
      </div>
    </div>

    <div class="panel">
      <h2>Character Summary</h2>
      <div class="summary-box" style="margin-top:0;">
        <div class="summary-row"><span>Total Cost (pts)</span><span>{{ totalCost }} pts</span></div>
        <div class="summary-row" style="margin-top:5px;color:var(--gold);font-weight:bold;">
          <span>Available EXP:</span>
          <span :style="{color: availableExp < 0 ? 'var(--red)' : 'var(--green)'}">{{ availableExp }} pts</span>
        </div>
        <div class="summary-row" style="margin-top:5px;color:var(--dim);">
          <span>Spent EXP (Stats+Skills):</span><span>{{ spentExp }}</span>
        </div>
      </div>
      <h2 style="margin-top:20px;">Special Rules</h2>
      <div class="rule-box" v-if="char.chapter !== 'None'">
        <div class="rule-title">Chapter: {{ char.chapter }}</div>
        <div class="rule-desc">{{ chapters[char.chapter].rules }}</div>
      </div>
      <div class="rule-box" v-if="char.cls !== 'None (Battle-Brother)'">
        <div class="rule-title">Profession: {{ char.cls }}</div>
        <div class="rule-desc">{{ classes[char.cls].desc }}</div>
      </div>
      <div class="rule-box">
        <div class="rule-title">Astartes (Level {{ currentRank.lvl }})</div>
        <div class="rule-desc">{{ innateRules }}</div>
      </div>
      <div class="rule-box" v-if="char.skills.length > 0">
        <div class="rule-title">Skills:</div>
        <ul style="margin:0;padding-left:15px;font-size:12px;color:var(--dim);">
          <li v-for="sk in char.skills" :key="sk"><b style="color:var(--txt)">{{ sk }}</b>: {{ getSkillDesc(sk) }}</li>
        </ul>
      </div>
      <h2 style="margin-top:20px;">Weapons & Armour</h2>
      <div v-if="selectedProfiles.length === 0" style="color:var(--dim);font-size:12px;text-align:center;">No wargear selected</div>
      <div v-for="prof in selectedProfiles" :key="prof.name" class="weapon-card">
        <div class="wname">
          <span>{{ prof.name }}</span>
          <span v-if="prof.qty > 1" style="color:var(--green);">x{{ prof.qty }}</span>
        </div>
        <div v-if="prof.name === 'Combi-Grenade Launcher' && char.combiGrenadeType" style="font-weight:bold;color:var(--gold);font-size:10px;margin-bottom:5px;">
          Loaded: {{ char.combiGrenadeType }} Grenades
        </div>
        <table v-if="prof.type === 'ranged'">
          <tr><th>Range</th><th>To Hit</th><th>Str</th><th>Dmg</th><th>Sv</th><th>AP</th></tr>
          <tr><td>{{ prof.short }}/{{ prof.long }}</td><td>{{ prof.hitS }}/{{ prof.hitL }}</td><td>{{ prof.str }}</td><td>{{ prof.dmg }}</td><td>{{ prof.saveMod }}</td><td>{{ prof.pen }}</td></tr>
        </table>
        <table v-if="prof.type === 'melee'">
          <tr><th>Str</th><th>Dmg</th><th>Sv</th><th>AP</th></tr>
          <tr><td>{{ prof.str }}</td><td>{{ prof.dmg }}</td><td>{{ prof.saveMod }}</td><td>{{ prof.pen }}</td></tr>
        </table>
        <div class="wspecial">{{ prof.special }}</div>
      </div>
      <h2 style="margin-top:20px;">Campaign Sheet</h2>
      <label>Notes</label><textarea v-model="char.notes" rows="2"></textarea>
      <label>Wounds & Injuries</label><textarea v-model="char.wounds" rows="2"></textarea>
      <label>Rewards & Trophies</label><textarea v-model="char.rewards" rows="2"></textarea>
    </div>
  </main>

  <!-- ============ COMPANY (MAIN) ============ -->
  <div v-if="tab==='company'" class="company-grid">
    <!-- LEFT COLUMN -->
    <div>
      <div class="panel">
        <h2>⚔ Squad Roster</h2>

        <div style="display:flex;gap:6px;margin-bottom:8px;">
          <button class="btn" style="flex:1;" @click="importRosterTXT">📥 Import TXT</button>
          <input ref="rosterFileInput" type="file" accept=".txt" style="display:none;" @change="onRosterFileSelected">
        </div>

        <label>Squad Name</label>
        <input type="text" v-model="company.squadName" placeholder="e.g., Strike Force Leonatos">

        <div class="summary-box" style="margin-top:10px;">
          <div class="summary-row"><span>Units in Roster</span><span>{{ company.roster.length }}</span></div>
          <div class="summary-row"><span>Ready for mission</span><span>{{ missionReadyRoster.length }}</span></div>
          <div class="summary-row total"><span>Squad Total</span><span>{{ squadTotalPts }} pts</span></div>
        </div>

        <h4 class="section-h">LIBRARY HEROES</h4>
        <div class="hint-box">
          Выберите сохранённых героев из Library или импортируйте TXT от другого игрока.
        </div>
        <div class="item-list" style="max-height:240px;">
          <div v-if="!library.length" style="font-size:12px;color:var(--dim);text-align:center;padding:8px;">
            Library пуста. Создайте героя в 🛠 Builder → 💾 Save, или импортируйте TXT.
          </div>
