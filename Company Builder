    function parseCharacterTXT(txt) {
      const hero = defaultChar();
      const nameMatch = txt.match(/===\s*ASTARTES:\s*(.+?)\s*===/i);
      if (nameMatch) hero.name = nameMatch[1].trim();
      const campMatch = txt.match(/Campaign:\s*(.+)/i);
      if (campMatch) hero.campaign = campMatch[1].trim();
      const chapMatch = txt.match(/Chapter:\s*(.+)/i);
      if (chapMatch) { const ch = chapMatch[1].trim(); if (chapters[ch]) hero.chapter = ch; }
      const clsMatch = txt.match(/Profession:\s*(.+)/i);
      if (clsMatch) { const cl = clsMatch[1].trim(); if (classes[cl]) hero.cls = cl; }
      const expMatch = txt.match(/EXP:\s*(\d+)/i);
      if (expMatch) hero.exp = parseInt(expMatch[1], 10) || 0;
      const profMatch = txt.match(/Profile:\s*M(\d+)\s+WS(\d+)\s+BS(\d+)\s+S(\d+)\s+T(\d+)\s+W(\d+)\s+I(\d+)\s+A(\d+)\s+Ld(\d+)/i);
      if (profMatch) {
        hero.stats = { M:+profMatch[1], WS:+profMatch[2], BS:+profMatch[3], S:+profMatch[4], T:+profMatch[5],
          W:+profMatch[6], I:+profMatch[7], A:+profMatch[8], Ld:+profMatch[9] };
      }
      const wargearSection = txt.split(/WARGEAR:/i)[1];
      if (wargearSection) {
        const wargearBlock = wargearSection.split(/SKILLS:/i)[0];
        wargearBlock.split('\n').forEach(line => {
          const m = line.match(/^-\s*(.+?)\s*\((\d+)\s*pcs?\.?\)/i);
          if (m) { const qty = parseInt(m[2],10); if (qty > 0) hero.wargear[m[1].trim()] = qty; }
        });
      }
      const skillsSection = txt.split(/SKILLS:/i)[1];
      if (skillsSection) {
        skillsSection.split('\n').forEach(line => {
          const m = line.match(/^-\s*(.+)/);
          if (m) { const sk = m[1].trim(); if (skillList.find(s => s.name === sk)) hero.skills.push(sk); }
        });
      }
      hero.combiGrenadeType = 'Frag';
      return hero;
    }

