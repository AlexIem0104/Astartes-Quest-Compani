    const missionReadyRoster = computed(() => company.roster.filter(h => !(h.preGame && h.preGame.missGame)));
    const squadTotalPts = computed(() => missionReadyRoster.value.reduce((s,c) => s + calcCharCost(c), 0));
    const enemyTargetPts = computed(() => Math.floor(squadTotalPts.value * (difficulties[company.difficulty]||100) / 100));
    const enemyTotalPts = computed(() => company.enemy.reduce((s,e) => s + e.pts, 0));

    const enemyBreakdown = computed(() => {
      const map = {};
      company.enemy.forEach(u => {
        if (!map[u.name]) map[u.name] = { name: u.name, qty: 0, pts: 0 };
        map[u.name].qty += 1;
        map[u.name].pts += u.pts;
      });
      return Object.values(map).sort((a,b) => b.qty - a.qty || a.name.localeCompare(b.name));
    });

    function calcCharCost(c) {
      if (!c) return 0;
      const chap = chapters[c.chapter]?.cost || 0;
      const cls = classes[c.cls]?.cost || 0;
      let rankPts = 0;
      for (let i = ranks.length - 1; i >= 0; i--) {
        if ((c.exp || 0) >= ranks[i].exp) { rankPts = ranks[i].pts; break; }
      }
      let wg = 0;
      for (let cat in wargearCats) for (let it of wargearCats[cat].items) wg += (c.wargear?.[it.name] || 0) * it.cost;
      const skills = (c.skills?.length || 0) * 10;
      return chap + cls + rankPts + wg + skills;
    }

    function addToRoster(c) { company.roster.push(JSON.parse(JSON.stringify(c))); }

    function generateEnemy() {
      company.enemy = [];
      const pool = factions[company.faction].units;
      const target = enemyTargetPts.value;
      let guard = 0;
      while (enemyTotalPts.value < target && guard++ < 500) {
        const rem = target - enemyTotalPts.value;
        const aff = pool.filter(u => u.pts <= rem + Math.floor(target * 0.1));
        const pick = (aff.length ? aff : pool)[Math.floor(Math.random() * (aff.length || pool.length))];
        company.enemy.push({ ...pick, uid: Date.now() + Math.random() });
      }
    }

    const bossUnit = computed(() => {
      const f = factions[company.faction];
      if (!f) return { name:'—', pts:0, profile:'', desc:'', wargear:'', rules:'', stats:null };
      const sorted = [...f.units].sort((a,b) => b.pts - a.pts);
      const boss = sorted[0] || { name:'—', pts:0, wargear:'', rules:'', stats:null };
      let profile = '';
      if (boss.stats) {
        const s = boss.stats;
        profile = `M${s.M} WS${s.WS} BS${s.BS} S${s.S} T${s.T} W${s.W} I${s.I} A${s.A} Ld${s.Ld}`;
      } else {
        profile = `M:${boss.pts>100?5:4} WS:${Math.min(10,Math.floor(boss.pts/25))} BS:${Math.min(10,Math.floor(boss.pts/30))} S:${Math.min(10,Math.floor(boss.pts/25))} T:${Math.min(10,Math.floor(boss.pts/30))} W:${Math.min(5,Math.floor(boss.pts/60)+1)} I:${Math.min(10,Math.floor(boss.pts/30))} A:${Math.min(5,Math.floor(boss.pts/50)+1)} Ld:10`;
      }
      return {
        name: boss.name,
        pts: boss.pts,
        wargear: boss.wargear || '—',
        rules: boss.rules || '—',
        stats: boss.stats || null,
        profile,
