        else if (["Omnissian Power Axe","Forge Bolter","Grav Pistol","Servo-arm"].includes(item.name)) wargearWarning.value = "Techmarines only!";
        else if (item.name === "Assault Launcher") wargearWarning.value = "Requires Gravis Armour!";
        else if (item.name === "Volkite Charger") wargearWarning.value = "Requires Terminator Armour!";
        else if (item.name === "Heavy Bolt Rifle") wargearWarning.value = "Requires Heavy Support OR Gravis!";
